pipeline {
  agent any

  tools {
    'hudson.plugins.sonar.SonarRunnerInstallation' 'SonarScanner'
  }
  
  stages {
    stage('Install Node') {
        steps {
            sh '''
                mkdir -p "$NVM_DIR"
                curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
                export NVM_DIR="$NVM_DIR"
                [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                nvm install 18
                
                echo '#!/bin/bash' > with-node.sh
                echo 'export NVM_DIR="$WORKSPACE/.nvm"' >> with-node.sh
                echo '[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"' >> with-node.sh
                echo 'nvm use 18' >> with-node.sh
                echo '"$@"' >> with-node.sh
                chmod +x with-node.sh
            '''
        }
    }
        
    stage('Install Dependencies') {
      steps {
        sh 'npm install'
      }
    }

    stage('Run Linter') {
      steps {
        sh 'npm run lint'
      }
    }

    stage('Run Tests with Coverage') {
      steps {
        // Fails below 100% (coverageThreshold in jest.config.js); writes coverage/lcov.info.
        sh 'HUSKY=0 npm run test:coverage'
      }
    }

    stage('SonarQube Analysis') {
      when {
        not { environment name: 'SKIP_SONAR', value: 'true' }
      }
      steps {
        script {
          def scannerHome = tool 'SonarScanner'
          withSonarQubeEnv('SonarScanner') {
            // Reads sonar-project.properties (sources, tests, lcov and JUnit paths).
            sh "${scannerHome}/bin/sonar-scanner"
          }
        }
      }
    }

    stage('Build Project') {
      steps {
        sh 'npm run build'
      }
    }
  }
}
